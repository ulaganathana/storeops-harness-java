<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- RawThrow applies ONLY to files under a service/ or controller/ directory -->
  <suppress id="RawThrow" files="^(?!.*[\\/](service|controller)[\\/]).*\.java$"/>
</suppressions>
